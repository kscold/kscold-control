server {
    listen 80;
    server_name kscold.com www.kscold.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://kscold.com$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.kscold.com;

    ssl_certificate     /etc/nginx/ssl/kscold.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/kscold.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000" always;

    return 301 https://kscold.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name kscold.com;

    limit_req zone=kscold_auth burst=10 nodelay;
    limit_req zone=kscold_recovery burst=3 nodelay;
    limit_req zone=kscold_external burst=10 nodelay;
    limit_req zone=kscold_upload burst=4 nodelay;
    limit_req zone=kscold_commercial burst=6 nodelay;
    limit_req zone=kscold_engagement burst=15 nodelay;
    limit_req_status 429;
    limit_req_log_level warn;

    ssl_certificate     /etc/nginx/ssl/kscold.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/kscold.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # 결제·광고 스크립트의 허용 목록은 유지하면서 브라우저 기본 공격면만 닫는다.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "base-uri 'self'; frame-ancestors 'none'; object-src 'none'" always;

    # Spring multipart 상한과 맞춰 거부될 요청 본문을 프록시 전에 차단한다.
    client_max_body_size 10M;

    # Agent SSE는 프록시 버퍼링과 압축을 끄고 백엔드보다 긴 연결 시간을 보장한다.
    location = /api/vault/agent/chat/stream {
        proxy_pass http://ubuntu-blog:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        gzip off;
    }

    # 피드 생성과 단건 수정 요청은 JSON 본문 상한을 별도로 낮춘다.
    # GET·DELETE도 같은 URI를 쓰지만 본문이 없으므로 응답과 라우팅에는 영향이 없다.
    location ~ ^/api/feeds(?:/[^/]+)?/?$ {
        client_max_body_size 256k;
        proxy_pass http://ubuntu-blog:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://ubuntu-blog:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://ubuntu-blog:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ws/ {
        proxy_pass http://ubuntu-blog:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    location /ws/ {
        proxy_pass http://ubuntu-blog:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    location / {
        proxy_pass http://ubuntu-blog:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
