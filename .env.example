# Database Configuration
DATABASE_URL=postgresql://admin:change-me@localhost:5432/kscold-infra-db
INFRA_DB_NAME=kscold-infra-db
INFRA_DB_USER=admin
INFRA_DB_PASSWORD=change-me

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret

# Admin User (for seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
SEED_ADMIN_BOOTSTRAP=false

# Application
NODE_ENV=development
TYPEORM_SYNCHRONIZE=false
PORT=4000
FRONTEND_URL=http://localhost:3000
DOCKER_HOST=unix:///var/run/docker.sock
REPOSITORY_STORAGE_DIR=/home/your-user/repository-storage
REPOSITORY_UPLOAD_SESSION_DIR=/home/your-user/repository-storage/.upload-sessions
SECURITY_ALLOWLIST=127.0.0.1,::1

# AI Provider Configuration
# Claude working directory (used by Claude Code & Codex CLI)
CLAUDE_WORKING_DIR=/Users/your-user/Desktop
CLAUDE_CODE_BIN=
CLAUDE_BINARY_PATH=

# OpenAI (Chat API + Codex CLI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: path to codex binary (defaults to 'codex' on $PATH)
CODEX_BIN=/usr/local/bin/codex

# Optional: Logging
LOG_LEVEL=info

# GoLe production key management
# Generate once with: openssl rand -base64 32
KEY_MANAGEMENT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
KEY_MANAGEMENT_GCP_PROJECT_ID=project-72a52bf1-06aa-4519-b2c
KEY_MANAGEMENT_GCP_SECRET_NAME=gole-production-env
KEY_MANAGEMENT_GCP_SERVICE_ACCOUNT=kscold-control-secrets@project-72a52bf1-06aa-4519-b2c.iam.gserviceaccount.com
KEY_MANAGEMENT_GCP_INSTANCE=gole-production
KEY_MANAGEMENT_GCP_ZONE=asia-northeast3-a
KEY_MANAGEMENT_GITHUB_REPOSITORY=GoLe-by-Colding/GoLe
KEY_MANAGEMENT_GITHUB_WORKFLOW=secret-sync.yml
KEY_MANAGEMENT_GITHUB_REF=main
KEY_MANAGEMENT_GCLOUD_PATH=/opt/homebrew/bin/gcloud
KEY_MANAGEMENT_GH_PATH=/opt/homebrew/bin/gh
KEY_MANAGEMENT_REQUIRED_KEYS=

# kscold Blog Runtime
BLOG_MONGODB_URI=mongodb://blog-user:change-me@127.0.0.1:27017/kscold-blog?authSource=admin
BLOG_JWT_SECRET=replace-with-a-long-random-secret
BLOG_JWT_REFRESH_SECRET=replace-with-another-long-random-secret
