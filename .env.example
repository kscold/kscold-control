# Database Configuration
DATABASE_URL=postgresql://admin:change-me@localhost:5432/kscold-infra-db
INFRA_DB_NAME=kscold-infra-db
INFRA_DB_USER=admin
INFRA_DB_PASSWORD=change-me

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret
# 2단계 인증(OTP) 비밀값과 복구 코드 해시에 쓰는 키. 비어 있거나 형식이 틀리면 백엔드가 기동하지 않는다.
# 한 번 만들고 바꾸지 않는다: openssl rand -base64 32
# 바꾸면 등록한 OTP 를 읽을 수 없어 모든 계정을 scripts/reset-user-mfa.mjs 로 해제해야 한다.
CONTROL_MFA_ENCRYPTION_KEY=
# 이 역할(쉼표로 구분)의 계정은 OTP 를 등록해야 로그인된다. 비우면 강제하지 않는다. 기본 admin,super_admin
# CONTROL_MFA_REQUIRED_ROLES=admin,super_admin
# 인증 앱에 보일 발급자 이름. 기본 kscold-control
# CONTROL_MFA_ISSUER=kscold-control

# Admin User (for seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
SEED_ADMIN_BOOTSTRAP=false

# Application
NODE_ENV=development
TYPEORM_SYNCHRONIZE=false
PORT=4000
# 백엔드가 여는 주소. 기본은 루프백이라 외부 주소에서 바로 닿지 않는다.
# 같은 컴퓨터의 다른 프로세스와 VM 안 컨테이너는 닿으므로 아래 CONTROL_PROXY_SECRET 을 함께 쓴다.
# 프록시가 다른 컴퓨터에 있을 때만 바꾼다.
CONTROL_BIND_HOST=127.0.0.1
# X-Real-IP 를 믿을 프록시 주소(쉼표로 구분, CIDR 가능). 비우면 루프백만 믿는다.
# 이 프록시는 X-Real-IP 를 실제 접속 주소로 덮어써야 한다.
CONTROL_TRUSTED_PROXIES=127.0.0.1,::1
# 프록시가 X-Control-Proxy-Secret 헤더로 보내는 값(32자 이상, 예: openssl rand -hex 32).
# 채우면 이 헤더까지 맞는 요청의 X-Real-IP 만 믿는다. 비우면 기동 때 경고만 남긴다.
CONTROL_PROXY_SECRET=
# 로그인 화면의 공개 회원가입. 기본은 닫혀 있고(가입 API 404), true 일 때만 승인 대기 계정으로 가입을 받는다.
CONTROL_REGISTRATION_ENABLED=false
FRONTEND_URL=http://localhost:3000
# Optional override; production defaults to runtime/frontend-current.
CONTROL_FRONTEND_DIST_PATH=
# 로컬 전용 Compose 파일의 절대 경로. 비우면 docker-compose.local.yml 사용.
CONTROL_COMPOSE_FILE=
# 외부 접속 안내용 호스트명. 비우면 UPnP로 조회한 주소 사용.
PUBLIC_HOST=
DOCKER_HOST=unix:///var/run/docker.sock
REPOSITORY_STORAGE_DIR=/home/your-user/repository-storage
REPOSITORY_UPLOAD_SESSION_DIR=/home/your-user/repository-storage/.upload-sessions
# 차단하지 않을 주소(쉼표로 구분, CIDR 가능). 잘못 적은 항목이 있으면 기동을 멈춘다.
# /16(IPv6 /48)까지 좁은 항목은 로그인 실패로 IP 를 막지 않고, 계정은 15분 30번 실패에서 잠근다.
# 더 넓은 항목은 차단에서 보호만 한다. 프록시 주소와 CONTROL_PROXY_SECRET 없이 온 주소는 예외를 받지 않는다.
SECURITY_ALLOWLIST=127.0.0.1,::1

# AI Provider Configuration
# Claude working directory (used by Claude Code & Codex CLI)
CLAUDE_WORKING_DIR=/Users/your-user/Desktop
CLAUDE_CODE_BIN=
CLAUDE_BINARY_PATH=
# Optional: 비우면 Claude CLI 는 `claude login` 으로 저장한 로그인을 쓴다.
# 에이전트에는 자기 API 키만 넘기고, 웹 터미널에는 어느 API 키도 넘기지 않는다.
ANTHROPIC_API_KEY=

# OpenAI (Chat API + Codex CLI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: path to codex binary (defaults to 'codex' on $PATH)
CODEX_BIN=/usr/local/bin/codex

# Optional: Logging
LOG_LEVEL=info

# Encrypts operational secrets kept in PostgreSQL: key-management backups and the
# connection URIs of backup targets (managed on the "백업 관리" page).
# Generate once with: openssl rand -base64 32
# Changing it makes stored ciphertext unreadable; backup target URIs must then be
# entered again.
KEY_MANAGEMENT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
KEY_MANAGEMENT_GCLOUD_PATH=gcloud
KEY_MANAGEMENT_GH_PATH=gh
KEY_MANAGEMENT_SSH_PATH=/usr/bin/ssh
KEY_MANAGEMENT_SSH_IDENTITY_DIR=

# Optional: 저장공간 화면에서 크기를 잴 폴더를 이 맥에 맞게 더한다 (JSON 배열, ~/ 사용 가능)
# STORAGE_EXTRA_FOLDERS='[{"label":"이관 백업","path":"~/.config/app/backups","description":"최신 하나만 남김"}]'
# Optional: 맥 데이터 볼륨과 Colima 도커 VM 디스크 위치 (기본값은 macOS·Colima 기본 경로)
# STORAGE_HOST_VOLUME=/System/Volumes/Data
# COLIMA_DATA_DISK=~/.colima/_lima/_disks/colima/datadisk
# COLIMA_BIN=colima
# Optional: SSH 접속 기록·차단 파일 폴더 (절대 경로, 기본 홈의 server-watchdog — ssh-audit.log, ssh-block-*.txt)
# SSH_AUDIT_DIR=/Users/me/server-watchdog
# Optional: 공격 지도에 쓰는 DB-IP City Lite 파일 (절대 경로, 비우면 지도를 끔)
# 받기: node scripts/fetch-ip-geo-db.mjs --out /absolute/path/dbip-city-lite.mmdb
# CONTROL_IP_GEO_DB_PATH=/Users/me/control-data/dbip-city-lite.mmdb
# Optional: 도커 VM 빈 공간을 맥에 돌려주는 매일 예약 시각 (기본 05:00, off 면 버튼으로만)
# STORAGE_TRIM_TIME=05:00
# Optional: 자동 작업 탭에 보여줄 macOS launchd 작업 등록 이름 앞부분 (쉼표로 구분)
# AUTOMATION_LAUNCHD_PREFIXES=com.example.,homebrew.mxcl.
# AUTOMATION_DESCRIPTIONS='{"com.example.watchdog":{"name":"서비스 감시","description":"10분마다 확인"}}'
# Optional: 배포마다 쌓이고 자동으로 정리되는 컨테이너 안 릴리스 폴더
# AUTOMATION_RELEASE_DIRS='[{"label":"배포 릴리스","container":"app","path":"/app/releases","keep":2,"stateFile":"/app/last-success.json"}]'
# 브라우저 원격 데스크톱은 기본 비활성화이며 관리자만 사용할 수 있음
REMOTE_DESKTOP_ENABLED=false
REMOTE_DESKTOP_ORIGIN=https://control.example.com
REMOTE_DESKTOP_PORT=5900
# 기본 원격 컴퓨터의 로그인 이름. 다른 대상에는 적용하지 않음.
REMOTE_DESKTOP_USERNAME=

