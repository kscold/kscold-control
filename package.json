{
  "name": "kscold-control",
  "version": "1.1.3",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.6",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "brace-expansion": "1.1.18",
      "browserslist": "4.28.9",
      "broadcast-channel": "7.3.0",
      "engine.io": "6.6.10",
      "fast-uri": "3.1.7",
      "flatted": "3.4.2",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.4",
      "multer": "2.2.0",
      "nanoid": "3.3.18",
      "qs": "6.16.0",
      "react-router": "7.18.3",
      "rollup": "4.62.2",
      "socket.io-parser": "4.2.7",
      "ws": "8.21.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && node ./scripts/write-release-manifest.mjs",
    "test:backend": "pnpm --filter @kscold-control/backend test",
    "test:frontend": "pnpm --filter @kscold-control/frontend test",
    "test:claude-smoke": "node ./scripts/claude-smoke.mjs",
    "test:repository-live-smoke": "node ./scripts/repository-live-smoke.mjs",
    "test:e2e:control": "bash ./scripts/run-control-e2e.sh",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "check:runtime-contracts": "node ./scripts/check-runtime-contracts.mjs",
    "preflight:production": "node ./scripts/preflight-control.mjs",
    "migrate:database": "node ./scripts/migrate-control-db.mjs",
    "verify:release": "node ./scripts/verify-release-manifest.mjs",
    "deploy:production": "node --env-file=.env ./scripts/deploy-control.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript-eslint": "^8.63.0"
  }
}
