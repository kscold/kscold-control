{
  "name": "kscold-control",
  "version": "1.4.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.6",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "brace-expansion": "1.1.21",
      "body-parser@2": "2.4.0",
      "browserslist": "4.28.9",
      "broadcast-channel": "7.3.0",
      "engine.io": "6.6.10",
      "fast-uri": "3.1.9",
      "@grpc/grpc-js": "1.14.5",
      "handlebars": "4.7.10",
      "flatted": "3.4.2",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.4",
      "moment": "2.31.0",
      "multer": "2.5.0",
      "nanoid": "3.3.18",
      "qs": "6.16.0",
      "proxy-addr": "2.0.8",
      "react-router": "7.18.3",
      "rollup": "4.62.2",
      "socket.io-parser": "4.2.7",
      "source-map-js": "1.2.2",
      "zod@4": "4.6.6",
      "ws": "8.21.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && node ./scripts/write-release-manifest.mjs",
    "test:backend": "pnpm --filter @kscold-control/backend test",
    "test:frontend": "pnpm --filter @kscold-control/frontend test",
    "test:claude-smoke": "node ./scripts/claude-smoke.mjs",
    "test:repository-live-smoke": "node ./scripts/repository-live-smoke.mjs",
    "test:release-publisher": "node --test ./scripts/test/frontend-release.test.mjs",
    "test:repository-maintenance": "node --test ./scripts/test/repository-rename.test.mjs",
    "test:frontend-bundle": "node --test ./scripts/test/frontend-bundle.test.mjs",
    "test:e2e:control": "bash ./scripts/run-control-e2e.sh",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "check:nginx": "bash ./scripts/check-nginx-config.sh",
    "check:runtime-contracts": "node ./scripts/check-runtime-contracts.mjs",
    "check:public-source": "node ./scripts/check-public-source.mjs",
    "preflight:production": "node ./scripts/preflight-control.mjs",
    "migrate:database": "node --env-file-if-exists=.env ./scripts/migrate-control-db.mjs",
    "verify:release": "node ./scripts/verify-release-manifest.mjs",
    "deploy:production": "node --env-file=.env ./scripts/deploy-control.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript-eslint": "^8.71.0"
  }
}
