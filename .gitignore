# Local-only infra overrides
nginx/conf.d/*.conf
# 설정을 고치기 전에 남기는 백업본 (실제 도메인·업스트림이 들어 있고, 남아 있으면 배포 전 변경 검사에 걸린다)
nginx/conf.d/*.conf.bak-*
nginx/conf.d/*.conf.disabled
nginx/conf.d/local/
nginx/conf.d/*.local.conf
nginx/conf.d/*.private.conf

# Documentation
docs/
CLAUDE.md

# Serena MCP 메타데이터
.serena/

# SSL certificates & private keys
ssl/
certbot-config/
*.pem
*.key

# Logs (런타임 로그 출력 디렉토리·파일 무시)
/logs/
apps/*/logs/
# 잘못된 cwd로 중첩 생성된 로그 경로 방어
apps/*/apps/
*.log
*.log.gz
*.log.*
*-audit.json
apps/backend/data/
# 소스 코드 내 logs 폴더는 추적 (backend logs 모듈, frontend logs feature 등)
!**/src/logs/
!**/src/logs/**
!**/src/features/logs/
!**/src/features/logs/**
apps/backend/src/seed.ts

# Keep tracked examples for local setup
!env/*.example
!nginx/conf.d/*.conf.example
