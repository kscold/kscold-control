# 실제 값은 저장소 밖의 mode 600 파일에 작성한다. 이미지에 복사하지 않는다.
# MONGODB_URI와 기존 .env는 그대로 옮긴다. 내부 주소는 Supervisor/launcher가 실행 환경에서만 바꾼다.
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENAI_API_KEY=
QDRANT_COLLECTION=vault_notes
VAULT_AGENT_WEB_SEARCH_ENABLED=true
VAULT_AGENT_INDEX_SYNC_INTERVAL_SECONDS=900
CORS_ORIGINS=https://kscold.com
AUTH_COOKIE_SECURE=true
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=blog
MINIO_PRIVATE_DOCUMENTS_BUCKET=blog-private-documents
MINIO_PUBLIC_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
NOTIFICATION_DISCORD_ENABLED=true
CHAT_REMINDER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
TEAM_PRIVATE_PASSWORD=
GITHUB_TOKEN=
